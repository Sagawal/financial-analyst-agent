# Required by SEC EDGAR. Use a real contact email in the User-Agent.
SEC_USER_AGENT=FinancialAnalystAgent/0.1 your.name@example.com

# We'll use this in a later step for the Groq LLM.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# We'll configure BGE in a later step.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
